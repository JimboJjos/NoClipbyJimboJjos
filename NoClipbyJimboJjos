--========================================================
-- ОБНОВЛЕНИЕ GUI
--========================================================

local function updateGUI()
	if noclipEnabled then
		toggleButton.Text = "NoClip: ON"
		toggleButton.BackgroundColor3 = NOCLIP_ON_COLOR

		statusLabel.Text = "Статус: ВКЛЮЧЕН"
		statusLabel.TextColor3 = NOCLIP_ON_COLOR
	else
		toggleButton.Text = "NoClip: OFF"
		toggleButton.BackgroundColor3 = NOCLIP_OFF_COLOR

		statusLabel.Text = "Статус: ВЫКЛЮЧЕН"
		statusLabel.TextColor3 = NOCLIP_OFF_COLOR
	end
end

--========================================================
-- СОХРАНЕНИЕ COLLISION
--========================================================

local function saveCollision(character)
	savedCollision = {}

	for _, object in ipairs(character:GetDescendants()) do
		if object:IsA("BasePart") then
			savedCollision[object] = object.CanCollide
		end
	end
end

--========================================================
-- ВОССТАНОВЛЕНИЕ COLLISION
--========================================================

local function restoreCollision(character)
	for _, object in ipairs(character:GetDescendants()) do
		if object:IsA("BasePart") then
			if savedCollision[object] ~= nil then
				object.CanCollide = savedCollision[object]
			end
		end
	end

	savedCollision = {}
end

--========================================================
-- ПРИМЕНЕНИЕ NOCLIP
--========================================================

local function applyNoclip(character)
	for _, object in ipairs(character:GetDescendants()) do
		if object:IsA("BasePart") then
			object.CanCollide = false
		end
	end
end

--========================================================
-- ВКЛЮЧЕНИЕ NOCLIP
--========================================================

local function enableNoclip()
	local character = player.Character

	if not character then
		return
	end

	saveCollision(character)
	noclipEnabled = true

	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end

	noclipConnection = RunService.Stepped:Connect(function()
		if not noclipEnabled then
			return
		end

		local currentCharacter = player.Character

		if currentCharacter then
			applyNoclip(currentCharacter)
		end
	end)

	applyNoclip(character)
	updateGUI()
end

--========================================================
-- ВЫКЛЮЧЕНИЕ NOCLIP
--========================================================

local function disableNoclip()
	noclipEnabled = false

	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end

	local character = player.Character

	if character then
		restoreCollision(character)
	end

	updateGUI()
end

--========================================================
-- ПЕРЕКЛЮЧАТЕЛЬ
--========================================================

toggleButton.MouseButton1Click:Connect(function()
	if noclipEnabled then
		disableNoclip()
	else
		enableNoclip()
	end
end)

--========================================================
-- ОТКРЫТЬ / ЗАКРЫТЬ
--========================================================

openButton.MouseButton1Click:Connect(function()
	frame.Visible = not frame.Visible
end)

closeButton.MouseButton1Click:Connect(function()
	frame.Visible = false
end)

--========================================================
-- КЛАВИША N
--========================================================

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	if input.KeyCode == Enum.KeyCode.N then
		frame.Visible = not frame.Visible
	end
end)

--========================================================
-- РЕСПАВН
--========================================================

player.CharacterAdded:Connect(function(character)
	savedCollision = {}

	local humanoidRootPart = character:WaitForChild("HumanoidRootPart", 10)

	if not humanoidRootPart then
		return
	end

	task.wait(0.2)

	if noclipEnabled then
		saveCollision(character)
		applyNoclip(character)
	end
end)

--========================================================
-- ПЕРВОНАЧАЛЬНОЕ СОСТОЯНИЕ
--========================================================

updateGUI()
